# --- Middleware Configuration ---
MCP_PORT=8080
BASE_URL=http://localhost:8080
DATABASE_PATH=./data/erpbridge.db
REDIS_URL=redis://localhost:6379
ERP_BASE_URL=http://localhost:8081
RATE_LIMIT_RPS=5
RATE_LIMIT_BURST=10
LOG_LEVEL=info
APP_ENV=development

# --- Security & Secrets ---
# Referenced as 'credentialRef' in tool schemas. Set this outside the repository.
ERP_PRIMARY_KEY=

# --- CLI (bridgectl) Configuration ---
BRIDGE_CONTEXT=local
BRIDGE_SERVER=http://localhost:8080
BRIDGE_MCP_SERVER=http://localhost:8080
BRIDGE_ERP_BASE=http://localhost:8081
BRIDGE_AUTH_TYPE=api-key
BRIDGE_API_KEY=your-api-key-here
BRIDGE_AUTH_HEADER=Authorization
# BRIDGE_TOKEN=your-bearer-token
# BRIDGE_USERNAME=admin
# BRIDGE_PASSWORD=password
# Note: BRIDGE_ERP_BASE and the BRIDGE_AUTH_* variables are parsed by the CLI
# but not consumed by any command yet.

# --- Mock ERP Configuration ---
MOCK_ERP_PORT=8081
MOCK_ERP_LOG_LEVEL=debug
